# Chỉ dùng các giá trị mẫu này trên máy dev. Giữ các URL khớp với tài khoản PostgreSQL bên dưới.
ENV=dev
POSTGRES_USER=videocall_migrate
POSTGRES_PASSWORD=dev-migrate-change-me
POSTGRES_DB=videocall
POSTGRES_APP_USER=videocall_app
POSTGRES_APP_PASSWORD=dev-app-change-me
MIGRATION_DATABASE_URL=postgresql+asyncpg://videocall_migrate:dev-migrate-change-me@db:5432/videocall
DATABASE_URL=postgresql+asyncpg://videocall_app:dev-app-change-me@db:5432/videocall

JWT_SECRET=dev-only-insecure-example-replace-before-deploy
TURN_SECRET=dev-turn-change-me
TURN_HOST=127.0.0.1
# Compose tạo TURN_URLS từ TURN_HOST. Đặt TURN_URLS nếu cần dùng máy chủ ICE khác.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
PUBLIC_BASE_URL=
FORWARDED_ALLOW_IPS=
ADMIN_ALLOWED_IPS=
PROMETHEUS_URL=
